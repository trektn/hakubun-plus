msgstr "n日後"

#: hakubun/ui/qt/settings.py:347
msgid "Autosend"
msgstr "自動送信"

#: hakubun/ui/qt/settings.py:350
msgid "Immediately after every change"
msgstr "変更のたびに即座に"

#: hakubun/ui/qt/settings.py:351
msgid "After n minutes"
msgstr "n分後"

#: hakubun/ui/qt/settings.py:355
