#: hakubun/ui/qt/settings.py:261 hakubun/ui/gtk/data/settingswindow.ui:363
msgid "Only applies when the player above is mpv. Hands off playback to the already-running mpv window via its IPC socket instead of starting a new process each time."
msgstr "僅當上面的播放器是 mpv 時適用。透過其 IPC 通訊端將播放交給已在執行的 mpv 視窗，而不是每次都啟動新程序。"

#: hakubun/ui/qt/settings.py:264
msgid "Media directories"
msgstr "媒體目錄"

#: hakubun/ui/qt/settings.py:267
msgid "Add..."
msgstr "新增…"

#: hakubun/ui/qt/settings.py:269
msgid "Remove"
msgstr "移除"

#: hakubun/ui/qt/settings.py:279 hakubun/ui/gtk/data/settingswindow.ui:447
msgid "When library scanning matches your media directories against the list, only Watching/Plan to Watch shows are considered by default. Enable this to also match against Completed, Dropped, and other statuses."
msgstr "媒體庫掃描比對媒體目錄與清單時，預設只考慮觀看中/計畫觀看的作品。啟用此項也會比對已完成、已放棄等其他狀態。"

#: hakubun/ui/qt/settings.py:287 hakubun/ui/gtk/data/settingswindow.ui:375
msgid "Parser"
msgstr "剖析器"

#: hakubun/ui/qt/settings.py:291
msgid "Player"
msgstr "播放器"

#: hakubun/ui/qt/settings.py:297
msgid "Reuse existing mpv window"
msgstr "重複使用現有的 mpv 視窗"

#: hakubun/ui/qt/settings.py:307
