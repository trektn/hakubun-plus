#: hakubun/ui/gtk/data/settingswindow.ui:1517
msgid "Change status when updating"
msgstr "Cambiar el estado al actualizar"

#: hakubun/ui/gtk/data/settingswindow.ui:1522
msgid "Moves a show to its start status (e.g. Watching) when you set episode 1, and to its finish status (e.g. Completed) when you set its last episode."
msgstr "Mueve una serie a su estado inicial (p. ej. Viendo) al poner el episodio 1, y a su estado final (p. ej. Completado) al poner su último episodio."

#: hakubun/ui/gtk/data/settingswindow.ui:1532
msgid "Change status only if it has a score"
msgstr "Cambiar el estado solo si tiene puntuación"

#: hakubun/ui/gtk/data/settingswindow.ui:1538
msgid "Only applies to the finish-status change above: hold off moving the show to its finish status until it has a score, instead of doing it as soon as the last episode is set."
msgstr "Solo se aplica al cambio de estado final anterior: retrasa mover la serie a su estado final hasta que tenga puntuación, en lugar de hacerlo en cuanto se pone el último episodio."

#: hakubun/ui/gtk/data/settingswindow.ui:1548
msgid "Update start and finish dates"
msgstr "Actualizar fechas de inicio y fin"

#: hakubun/ui/gtk/data/settingswindow.ui:1586
#: hakubun/ui/gtk/data/shortcuts.ui:11
msgid "Lists"
msgstr "Listas"

#: hakubun/ui/gtk/data/settingswindow.ui:1611
msgid "Remember window size"
msgstr "Recordar tamaño de ventana"

#: hakubun/ui/gtk/data/settingswindow.ui:1625
msgid "Use classic progress bar"
msgstr "Usar barra de progreso clásica"

#: hakubun/ui/gtk/data/settingswindow.ui:1639
msgid "Switch to the All category when filtering"
msgstr "Cambiar a la categoría Todos al filtrar"

#: hakubun/ui/gtk/data/settingswindow.ui:1644
msgid "When typing in the filter bar while on a specific status tab, automatically switch to the All tab so the filter searches your whole list instead of just that status."
msgstr "Al escribir en la barra de filtro mientras estás en una pestaña de estado concreta, cambia automáticamente a la pestaña Todos para que el filtro busque en toda tu lista en lugar de solo en ese estado."

#: hakubun/ui/gtk/data/settingswindow.ui:1654
msgid "Show tray icon"
msgstr "Mostrar icono de bandeja"

#: hakubun/ui/gtk/data/settingswindow.ui:1675
msgid "Close to tray"
msgstr "Cerrar a la bandeja"

#: hakubun/ui/gtk/data/settingswindow.ui:1689
msgid "Start minimized to tray"
msgstr "Iniciar minimizado en la bandeja"

#: hakubun/ui/gtk/data/settingswindow.ui:1703
msgid "Use website icon in tray"
msgstr "Usar el icono del sitio web en la bandeja"

#: hakubun/ui/gtk/data/settingswindow.ui:1724
msgid "Show the SubMiner switch in the header bar"
msgstr "Mostrar el interruptor de SubMiner en la barra de cabecera"

#: hakubun/ui/gtk/data/settingswindow.ui:1729
msgid "Purely cosmetic -- hiding the switch doesn't turn SubMiner off. Settings > Media still controls whether episodes open with SubMiner."
msgstr "Puramente estético: ocultar el interruptor no desactiva SubMiner. Ajustes > Multimedia sigue controlando si los episodios se abren con SubMiner."

#: hakubun/ui/gtk/data/settingswindow.ui:1754
msgid "Colors for row text"
msgstr "Colores del texto de fila"

