#: hakubun/ui/qt/settings.py:376 hakubun/ui/gtk/data/settingswindow.ui:1522
msgid "Moves a show to its start status (e.g. Watching) when you set episode 1, and to its finish status (e.g. Completed) when you set its last episode."
msgstr "Mueve una serie a su estado inicial (p. ej. Viendo) al poner el episodio 1, y a su estado final (p. ej. Completado) al poner su último episodio."

#: hakubun/ui/qt/settings.py:381
msgid "Change status automatically only if scored"
msgstr "Cambiar el estado automáticamente solo si tiene puntuación"

#: hakubun/ui/qt/settings.py:383 hakubun/ui/gtk/data/settingswindow.ui:1538
msgid "Only applies to the finish-status change above: hold off moving the show to its finish status until it has a score, instead of doing it as soon as the last episode is set."
msgstr "Solo se aplica al cambio de estado final anterior: retrasa mover la serie a su estado final hasta que tenga puntuación, en lugar de hacerlo en cuanto se pone el último episodio."

#: hakubun/ui/qt/settings.py:387
msgid "Change start and finish dates automatically"
msgstr "Cambiar fechas de inicio y fin automáticamente"

#: hakubun/ui/qt/settings.py:406 hakubun/ui/gtk/data/settingswindow.ui:2232
